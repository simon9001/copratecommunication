# ============================================================
# KeNHA VR Projects — Backend Environment (PostgreSQL / Supabase)
# Validated by src/config/env.ts. The server exits on startup if
# a REQUIRED value is missing or invalid.
#
# Setup order:
#   1. Run supabase/schema.sql in the Supabase SQL Editor
#   2. Fill in DATABASE_URL below
#   3. pnpm db:diagnose     (confirms connection + schema)
#   4. pnpm dev
# ============================================================

# ---------- Application Server ----------
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ---------- Database (REQUIRED) ----------
# Copy this from Supabase → Project Settings → Database → Connection
# string → Session pooler. The region is part of the hostname.
#
# Get it from: Supabase → Project Settings → Database → Database password
# (you can reset it there; the reset does not affect your API keys).
#
# Do NOT use db.YOUR-PROJECT-REF.supabase.co — that host has an IPv6
# address only (no A record), so it is unreachable from IPv4-only
# networks unless you buy Supabase's IPv4 add-on. The pooler below is
# dual-stack and needs no add-on.
#
#   port 5432 = session mode     (use for local dev; supports everything)
#   port 6543 = transaction mode (use on serverless; no prepared statements)
#
# If the password contains @ : / ? # or %, percent-encode it in the URL
# (@ -> %40, # -> %23). Otherwise the URL parser mistakes it for the host.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-1-YOUR-REGION.pooler.supabase.com:5432/postgres

# Alternative to DATABASE_URL — supply these instead if you prefer.
# DATABASE_URL wins when both are present.
# DB_HOST=aws-1-YOUR-REGION.pooler.supabase.com
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USER=postgres.YOUR-PROJECT-REF
# DB_PASSWORD=YOUR-DB-PASSWORD

# Supabase refuses plaintext connections. Only set this false for a
# local Postgres that has no TLS.
DB_SSL=true

# Max pooled connections. Keep this well under your Supabase plan's
# limit, especially on the direct (5432) connection.
DB_POOL_MAX=10

# ---------- Supabase HTTP APIs (OPTIONAL) ----------
# These are NOT needed to read or write the database. DATABASE_URL above
# already does that, and it connects as the 'postgres' role, which owns
# the tables — Postgres does not apply RLS policies to a table's owner.
# So RLS being enabled does not block the API.
#
# Fill these in for Supabase Storage or the admin API.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses EVERY access rule in the project.
# Server-side only: never send it to a browser, never give it a VITE_
# prefix, never commit it.
# Supabase → Project Settings → API → service_role key.
# This key bypasses every access rule: server-side only, never commit it.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# The anon key is public and IS subject to RLS. The server has no use for
# it — it belongs in the frontend, if you ever call Supabase from there.
# SUPABASE_ANON_KEY=

# ---------- Authentication (REQUIRED) ----------
# JWT_SECRET must be at least 8 characters. Replace this before
# deploying anywhere real:  openssl rand -base64 48
JWT_SECRET=change-me-openssl-rand-base64-48
JWT_EXPIRES_IN=24h

# ---------- Cloudinary Media Storage (OPTIONAL) ----------
# Without all three of cloud name / key / secret, Cloudinary features
# start in "unconfigured mode" and the health probe says so.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# ---------- Alerting (OPTIONAL) ----------
# Slack-style incoming webhook. Empty means console-only alerts.
ALERT_WEBHOOK_URL=
